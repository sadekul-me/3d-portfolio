# Public runtime configuration only.
# NEVER put LLM keys, SMTP credentials, database URLs, or other secrets here.
# Vite only exposes variables prefixed with VITE_PUBLIC_ to the browser.

# Application identity (safe to expose)
VITE_PUBLIC_APP_NAME=Digital Residence
VITE_PUBLIC_APP_VERSION=0.1.0
VITE_PUBLIC_BUILD_ID=local-dev

# Public site origin used for canonical URLs, sitemap, and JSON-LD.
# Replace with the production origin before launch.
VITE_PUBLIC_SITE_URL=http://localhost:5173

# Same-origin API prefix. Browser code must not call provider SDKs directly.
VITE_PUBLIC_API_BASE_URL=/api/v1

# Diagnostics HUD is development-only unless an explicit internal flag is set.
# Do not enable for public production visitors.
VITE_PUBLIC_ENABLE_DIAGNOSTICS=false
